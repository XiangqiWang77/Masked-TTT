{
  "schema": "contextual-cartridges-tracin-selective-protocol-v1",
  "protocol": "official-contextual-cartridges-tracin-selective-v26",
  "title": "Contextual Cartridges: Query-Guided Test-Time Learning with Selective Self-Distillation",
  "official_cartridges_commit": "ef34ba97a06049c34820506e2c283746284ae5f0",
  "backbone": "Qwen3-4B-Instruct-2507",
  "benchmark": "BABILong",
  "matrix": [
    "vanilla_syns_vanilla_sd",
    "vanilla_syns_selective_sd",
    "specific_syns_vanilla_sd",
    "specific_syns_selective_sd"
  ],
  "dataset_arms": [
    "vanilla_syns",
    "specific_syns"
  ],
  "sd_arms": [
    "vanilla_sd",
    "selective_sd"
  ],
  "development_cases": 160,
  "holdout_cases": 840,
  "development_source_questions": 40,
  "holdout_source_questions": 210,
  "production_phase": "closed_development_gate",
  "seed": 42,
  "cartridge": {
    "prefix_tokens": 512,
    "packed_tokens": 2048,
    "learning_rate": 0.02,
    "native_kv_only": true,
    "backbone_frozen": true,
    "attention_modified": false,
    "direct_answer_nll": false,
    "synthetic_answer_hard_label_loss": false
  },
  "teacher": {
    "context_policy": "official generation source for vanilla; bound query evidence for guided",
    "sampling_temperature": 0.0,
    "sparse_topk": 20,
    "fixed_synthetic_answer_trajectories": true,
    "old_teacher_targets_reused": false
  },
  "vanilla_sd": {
    "official_epochs": 2,
    "objective": "upstream sparse Teacher KL",
    "matched_update_reference_arm": "vanilla_syns_vanilla_sd"
  },
  "selective_sd": {
    "candidate_pool": "source-admitted Teacher trajectories",
    "method": "TracIn positive-influence selection",
    "reference_objective": "all ordinary-SD training trajectories",
    "checkpoints": [
      "initial_cartridge",
      "vanilla_SD"
    ],
    "leave_one_out_reference_when_candidate_is_in_reference": true,
    "score": "sum_c learning_rate_c * dot(grad_KV L_ref_without_i, grad_KV L_i)",
    "threshold": 0.0,
    "strict_rule": "keep iff summed TracIn score > 0",
    "heldout_set_used_for_selection": false,
    "benchmark_answers_used_for_selection": false,
    "consolidation_schedule": "ordinary SD first half; retained positive-influence trajectories second half",
    "empty_selection_policy": "reuse exact trained Vanilla-SD checkpoint",
    "first_order_local_influence_not_correctness_proof": true
  },
  "evaluation": {
    "metric": "official BABILong label accuracy",
    "references_used_only_after_inference": true,
    "missing_predictions_are_not_scored_as_wrong": true,
    "accuracy_comparisons_use_same_completed_cases": true,
    "paired_diagnostics": [
      "fixes",
      "regressions",
      "strict teacher-wrong and initial-wrong Oracle-escape cohort"
    ]
  },
  "exact_cluster_configuration": "configuration.cluster.json",
  "results_status": "running; no unfinished accuracy is included in this snapshot"
}
